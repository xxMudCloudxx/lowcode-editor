{
  "name": "@lowcode/expression",
  "version": "1.0.0",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --tsconfig tsconfig.build.json && tsc -p tsconfig.build.json --emitDeclarationOnly --declaration --declarationMap false --outDir dist",
    "dev": "tsup src/index.ts --format cjs,esm --watch --tsconfig tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^25.2.3",
    "tsup": "^8.0.0",
    "typescript": "^5.8.3",
    "vitest": "^4.0.18"
  }
}
