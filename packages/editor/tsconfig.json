{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "noEmit": true,
    "strict": false,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@lowcode/schema": ["../schema/src"],
      "@lowcode/expression": ["../expression/src"],
      "@lowcode/materials": ["../materials/src/index.tsx"],
      "@lowcode/renderer": ["../renderer/src/index.tsx"],
      "@lowcode/code-generator": ["../code-generator/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"],
  "references": [
    { "path": "../schema" },
    { "path": "../expression" }
  ]
}
